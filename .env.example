# FastAPI Settings
PROJECT_NAME="Caja Chica AI Bot"
ENVIRONMENT=local

# Meta/WhatsApp API
WHATSAPP_API_TOKEN=your_meta_access_token_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verification_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# OpenAI API
OPENAI_API_KEY=your_openai_share_key_here

# Celery & Redis
REDIS_URL=redis://redis:6379/0

# Base de Datos
DATABASE_URL=postgresql://postgres:postgres@db:5432/cajachicadb

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp_key.json

# Backups del sheet (6.5.5): copia local diaria completa. BACKUP_DIR es la ruta dentro
# del contenedor (montada como volumen con nombre backups_data). Horario en UTC.
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=90
BACKUP_CRON_HOUR=23
BACKUP_CRON_MINUTE=0

# Operación (Paso 1): alertas de salud por WhatsApp.
# ADMIN_PHONE recibe la alerta si /health deja de responder (formato 506...).
ADMIN_PHONE=
# URL interna del healthcheck que consulta el worker dentro de Docker.
HEALTHCHECK_URL=http://app:8000/health
# Seguridad #10: máximo de mensajes por teléfono por minuto (0 desactiva el control).
RATE_LIMIT_MENSAJES_POR_MINUTO=20
